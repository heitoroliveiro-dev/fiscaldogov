#!/usr/bin/env bash
# Gitflow + segredos + travas de qualidade por parte do repositório (research §9, T054).
# Ferramenta ausente bloqueia o commit com instrução: falha fechada, nunca pulo silencioso.
set -euo pipefail

branch="$(git symbolic-ref --short -q HEAD || true)"
git_dir="$(git rev-parse --git-dir)"
raiz="$(git rev-parse --show-toplevel)"

# Merge em andamento (ex.: release/hotfix sendo integrada) é permitido; commit avulso não.
if [ ! -f "$git_dir/MERGE_HEAD" ]; then
  case "$branch" in
    main|develop)
      echo "BLOQUEADO: commit direto em '$branch'. Crie uma branch (feature/, bugfix/, chore/, release/, hotfix/) — ver CONTRIBUTING.md."
      exit 1
      ;;
    feature/*|bugfix/*|chore/*|release/*|hotfix/*|"")
      ;;
    *)
      echo "BLOQUEADO: branch '$branch' fora do padrão gitflow (feature/, bugfix/, chore/, release/, hotfix/) — ver CONTRIBUTING.md."
      exit 1
      ;;
  esac
fi

"$raiz/scripts/check-no-secrets.sh"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# web/: ESLint, Prettier e os testes relacionados, só nos arquivos staged (web/.lintstagedrc.json)
if grep -q '^web/' <<<"$staged"; then
  if [ ! -x "$raiz/web/node_modules/.bin/lint-staged" ]; then
    echo "BLOQUEADO: dependências do site ausentes. Rode: npm --prefix web ci"
    exit 1
  fi
  (cd "$raiz/web" && node_modules/.bin/lint-staged)
fi

# etl/: formatação, lint e testes de unidade e arquitetura (o de integração fica no CI)
if grep -q '^etl/' <<<"$staged"; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "BLOQUEADO: uv não encontrado. Instale: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
  fi
  uv run --directory "$raiz/etl" --frozen ruff format --check
  uv run --directory "$raiz/etl" --frozen ruff check
  uv run --directory "$raiz/etl" --frozen pytest -m "not integration" -q
fi
