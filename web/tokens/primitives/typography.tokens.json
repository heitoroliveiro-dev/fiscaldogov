{
  "$description": "Tipografia. Inter (variável, com eixo de tamanho óptico: em tamanhos grandes renderiza o corte 'Display', como o Linear usa nos títulos). Geist Mono para código e atalhos.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "normal": {
        "$value": 400
      },
      "medium": {
        "$value": 510,
        "$description": "Pesos 510/590 do Inter variável: mais refinados que 500/600 em telas escuras."
      },
      "semibold": {
        "$value": 590
      },
      "bold": {
        "$value": 680
      }
    }
  },
  "text": {
    "$type": "typography",
    "$description": "Escala tipográfica. 13px (sm) é o corpo padrão de interfaces densas; 15–16px para conteúdo de leitura.",
