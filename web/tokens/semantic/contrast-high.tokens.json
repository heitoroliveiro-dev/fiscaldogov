    },
    "border": {
      "$value": "{color.gray.8}"
    },
    "border-subtle": {
      "$value": "{color.gray.7}"
    },
    "border-strong": {
      "$value": "{color.gray.10}"
    },
    "input": {
      "$value": "{color.gray.9}"
    },
    "ring": {
      "$value": "{color.brand.11}"
    },
    "sidebar-foreground": {
      "$value": "{color.gray.12}"
    },
    "sidebar-border": {
      "$value": "{color.gray.7}"
    }
  }
