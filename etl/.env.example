# Nomes de contracts/ambientes-e-segredos.md — valores reais só nos cofres dos provedores.
# Copie para etl/.env (fora do versionamento) e preencha para desenvolvimento local.

# Banco (papel etl_escrita; o dono só é usado para aplicar migrations)
DATABASE_URL_ESCRITA=
DATABASE_URL_DONO=

# Respostas brutas e cópias de segurança (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BRUTOS=fiscaldogov-brutos
R2_BUCKET_BACKUP=fiscaldogov-backup

# Disparo da publicação (token fine-grained, só este repositório)
GITHUB_TOKEN_PUBLICACAO=
GITHUB_REPOSITORIO=heitoroliveiro-dev/fiscaldogov

# Alertas (RNF07)
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT_ID=

# Fonte e limites
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2
ETL_TEMPO_LIMITE_S=3600

# Testes de integração (Postgres local do docker-compose, senhas de scripts/dev-banco-papeis.sql)
DATABASE_URL_TESTE=
DATABASE_URL_ESCRITA_TESTE=
DATABASE_URL_LEITURA_TESTE=
ETL_EXIGIR_INTEGRACAO=0
