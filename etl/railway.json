{
  "$schema": "https://backboard.railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "etl/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "sh -c 'cd /app/web && node_modules/.bin/prisma migrate deploy'"
    ],
    "startCommand": "python -m etl agendado",
    "cronSchedule": "0 6,8 * * *",
    "restartPolicyType": "NEVER"
  }
}
